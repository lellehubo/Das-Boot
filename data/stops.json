        "ropsten"
      ],
      "forward_direction_code": 1,
      "direction_note": "direction_code 1 ar mot Ropsten, alltsa framat i listan. Avlast ur SL:s realtidsflode."
    },
    "7": {
      "note": "Sparvag City, hallplatserna i ordning osterut till vasterut. Bara de appen anvander.",
      "stops": [
        "liljevalchs",
        "djurgardsbron",
        "nybroplan"
      ],
      "forward_direction_code": 2,
      "direction_note": "direction_code 2 ar mot T-Centralen, alltsa framat i listan. 1 ar mot Waldemarsudde, at andra hallet."
    },
    "67": {
      "note": "Buss 67, hallplatserna i ordning osterut till vasterut. Bara de appen anvander.",
      "stops": [
        "liljevalchs",
        "karlaplan"
      ],
      "forward_direction_code": 2,
      "direction_note": "direction_code 2 ar mot Frosundavik och gar via Karlaplan. 1 ar mot Blockhusudden, bort fran stan."
    },
    "13": {
      "note": "Tunnelbanans roda linje, Ropstensgrenen. Stationerna i ordning mot Ropsten.",
